# NeonDB connection string (Neon console → Connection Details). Optional:
# without it the site serves the bundled data in src/data.
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Volunteer admin (/admin). Both are needed to sign in.
# ADMIN_SESSION_SECRET: 32+ random characters, e.g. from `openssl rand -base64 48`.
ADMIN_PASSWORD=choose-a-strong-password
ADMIN_SESSION_SECRET=replace-with-32-or-more-random-characters

# Photo gallery uploads (Vercel Blob). Vercel adds this when you connect a Blob store;
# copy it from the project's environment variables for local testing.
BLOB_READ_WRITE_TOKEN=

# Optional: link to the chapter's WhatsApp channel, shown beside the sign-up form.
# VITE_WHATSAPP_URL=https://whatsapp.com/channel/…

# Map tiles. Optional: the default is OpenStreetMap, which needs no key.
# Set these to use a keyed provider instead, e.g. MapTiler:
# VITE_TILE_URL=https://api.maptiler.com/maps/dataviz/{z}/{x}/{y}.png?key=YOUR_KEY
# VITE_TILE_ATTRIBUTION=&copy; MapTiler &copy; OpenStreetMap contributors
